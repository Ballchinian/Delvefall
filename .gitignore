#the ingest script downloads this fresh every run
oracle-cards.json

__pycache__/
*.pyc

.vscode/

.env
.claude/

#finetune/ ships its SCRIPTS and keeps its DATA. the recipe is worth reading and
#the generated pairs, the hand judged verdicts and the trained models are the
#actual work, so the split runs between code and everything code produces.
#deny by default with named exceptions, so a new data file is private until
#someone says otherwise rather than the other way around
finetune/*
!finetune/README.md
!finetune/requirements.txt
!finetune/*.py

#what the scripts read and write. traindata and testing_list are the work
#itself, out is regenerable and dull, models are a gigabyte each and past what
#github accepts anyway
finetune/traindata/
finetune/testing_list/
finetune/out/
finetune/models/

#the v1 era in full, data included: the model it built was retired 2026-07-22,
#so it tells the whole story without saying how the live one learned. named
#explicitly because finetune/* above excludes the DIRECTORY, and nothing under
#an excluded directory can be re-included one file at a time
!finetune/legacy/

#the v1 era in full: its training data, its scripts and the evidence they
#produced. the site stopped serving that model on 2026-07-22, so publishing it
#says how the model was ORIGINALLY trained without saying how the live one is.
#allowing the folder is enough, because finetune/* above only matches one level
#deep and nothing below excludes it again
!finetune/legacy/

#the bundle for the colab box
delvefall-training.zip
*-training.zip

